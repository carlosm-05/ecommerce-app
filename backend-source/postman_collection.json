                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Cambiar contraseña",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Demo12345\",\n  \"newPassword\": \"Demo123456\",\n  \"confirmPassword\": \"Demo123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
