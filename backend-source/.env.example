# Copia este archivo como .env y cambia los valores.
# Lo leen tanto la API (mvnw spring-boot:run) como docker compose. .env NO se sube a git.

# --- Base de datos para ejecutar SIN Docker. Si no defines DB_URL se usa H2 local.
# Supabase: Project Settings -> Database -> Connection string -> JDBC -> "Session pooler"
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<id-del-proyecto>
# DB_PASSWORD=<tu-contraseña>
# DB_POOL_SIZE=5
# H2_CONSOLE=false

# --- MySQL de docker compose (solo se usa con Docker)
MYSQL_APP_USER=ecommerce
MYSQL_APP_PASSWORD=ecommerce123
MYSQL_ROOT_PASSWORD=root123

# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-123456
JWT_EXPIRATION_MINUTES=1440

RESET_PASSWORD_URL=http://localhost:8080/reset-password.html?token=

# --- Correo. Por defecto usa Mailpit (http://localhost:8025), no hay que configurar nada.
# Para Gmail descomenta y usa una "contraseña de aplicación":
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tucorreo@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=tucorreo@gmail.com
